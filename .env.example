# Goonj environment configuration (copy to .env and adjust).
# Never commit the real .env file.

# --- Core ---
GOONJ_ENV=development
LOG_LEVEL=info

# --- Database ---
POSTGRES_USER=goonj
POSTGRES_PASSWORD=goonj
POSTGRES_DB=goonj
# Host-side port for the compose postgres (host 5432 may already be taken)
POSTGRES_HOST_PORT=5433
# URL for running Go services natively against the compose postgres
DATABASE_URL=postgres://goonj:goonj@localhost:5433/goonj?sslmode=disable

# --- Redis (cache, queues, presence) ---
# Host-side port for the compose redis (host 6379 may already be taken)
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- HTTP services ---
HTTP_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
# Host-side port for the compose ws-gateway
WS_HOST_PORT=8082

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Object storage (floci/MinIO in dev, S3/R2 in prod) ---
# S3_ENDPOINT: what api/worker use inside the compose network.
# S3_PUBLIC_ENDPOINT: what browsers use for presigned upload/playback URLs.
S3_ENDPOINT=http://floci:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=goonj-audio-dev
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_USE_PATH_STYLE=true
# Optional CDN in front of processed audio (prod). When set, playback URLs
# become CDN/<key> instead of presigned GETs; the CDN origin authenticates
# to the bucket (public-read policy or OAC-style origin credentials).
# S3_CDN_BASE_URL=https://cdn.example.com

# --- Auth ---
JWT_SECRET=dev-only-secret-change-me
# Superseded signing keys accepted for VALIDATION only (rotation grace).
# Comma-separated, newest previous first. Set together with a new JWT_SECRET,
# deploy, then remove once every session could have refreshed.
# JWT_SECRETS_PREVIOUS=

# --- Live (LiveKit) — Phase 2/3 ---
# Browser clients connect to LIVEKIT_CLIENT_URL (ws://localhost:7880 locally);
# the API and worker use LIVEKIT_URL for server-side calls (tokens, egress).
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_CLIENT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Production: serve LiveKit behind TLS and put its public wss:// endpoint in
# LIVEKIT_CLIENT_URL; TURN + the published UDP range are configured in the
# LiveKit server config (rtc.turn / rtc.udp_port), not per app (PROBLEMS #5/#6).
# Egress service writes session recordings to S3 under this prefix.
LIVEKIT_RECORDING_PREFIX=live/recordings

# --- AI (Phase 5: transcription, embeddings, summaries) ---
# Everything is optional; without keys the stack runs the local baselines:
#   transcription skipped, hash embeddings (1536d), extractive summaries.
# With OPENAI_API_KEY set: whisper-1 STT, text-embedding-3-small, gpt-4o-mini
# summaries (override per feature below). OPENAI_BASE_URL points at any
# OpenAI-compatible gateway (Azure proxy, llama.cpp server, ...).
#
# Groq example (fast STT + chat; see https://console.groq.com/docs/models):
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_STT_MODEL=whisper-large-v3-turbo      # $0.04/hr, 100MB cap
#   OPENAI_SUMMARY_MODEL=openai/gpt-oss-120b     # chat summaries
#   EMBEDDINGS_DISABLED=1                        # Groq serves NO /embeddings;
#                                                # without this, semantic
#                                                # indexing breaks. Local hash
#                                                # embedder takes over.
# NOTE on Groq: whisper-large-v3-turbo supports verbose_json segments;
# the Realtime API (live captions / voice agent) is NOT offered — those
# features stay OpenAI-only and degrade to hidden UI without their key.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_STT_MODEL=whisper-1
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
# EMBEDDINGS_DISABLED=0
# whisper.cpp fallback (used only when no OpenAI key): binary + 16kHz model.
# WHISPER_CPP_BIN=/usr/local/bin/whisper-main
# WHISPER_CPP_MODEL=/models/ggml-base.en.bin

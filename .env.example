# Goonj environment configuration (copy to .env and adjust).
# Never commit the real .env file.

# --- Core ---
GOONJ_ENV=development
LOG_LEVEL=info

# --- Database ---
POSTGRES_USER=goonj
POSTGRES_PASSWORD=goonj
POSTGRES_DB=goonj
# Host-side port for the compose postgres (host 5432 may already be taken)
POSTGRES_HOST_PORT=5433
# URL for running Go services natively against the compose postgres
DATABASE_URL=postgres://goonj:goonj@localhost:5433/goonj?sslmode=disable

# --- Redis (cache, queues, presence) ---
# Host-side port for the compose redis (host 6379 may already be taken)
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- HTTP services ---
HTTP_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
# Host-side port for the compose ws-gateway
WS_HOST_PORT=8082

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Object storage (MinIO/floci in dev, S3/R2 in prod) — Phase 1 ---
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=goonj-audio-dev
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# --- Live (LiveKit) — Phase 2 ---
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# syntax=docker/dockerfile:1
# Next.js web app built with bun inside the bun workspace (root context).

FROM oven/bun:1 AS build
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY packages/api-client/package.json packages/api-client/
# schema.gen.ts is a generated source file, not an install artifact — include it
# so the workspace's typecheck/build steps see the generated types.
COPY packages/api-client/src/schema.gen.ts packages/api-client/src/schema.gen.ts
RUN bun install --frozen-lockfile
COPY apps/web apps/web
COPY packages packages
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time — the runtime
# `environment:` block in docker-compose.yml cannot change it. Pass the public
# API URL as a build arg so the browser fetches the right host.
ARG NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8082
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
RUN cd apps/web && bun run build

FROM oven/bun:1
WORKDIR /app/apps/web
# bun hoists node_modules to the workspace root — copy the whole workspace.
COPY --from=build /app /app
EXPOSE 3000
CMD ["bun", "run", "start"]
